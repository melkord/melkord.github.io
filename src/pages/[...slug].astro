---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return posts.map((post, index) => {
		// Sorted newest-first, so the next index is the chronologically previous post.
		const older = posts[index + 1];
		return {
			params: { slug: post.id },
			props: {
				post,
				prevPost: older ? { id: older.id, title: older.data.title } : null,
			},
		};
	});
}

type Props = {
	post: CollectionEntry<'blog'>;
	prevPost: { id: string; title: string } | null;
};

const { post, prevPost } = Astro.props;
const { Content } = await render(post);

const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(words / 200));
---

<BlogPost {...post.data} prevPost={prevPost} readingTime={readingTime}>
	<Content />
</BlogPost>
