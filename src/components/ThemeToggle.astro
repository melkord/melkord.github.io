---
---
<div class="theme-toggle" role="group" aria-label="Theme">
  <button type="button" data-set-theme="light">light</button>
  <button type="button" data-set-theme="dark">dark</button>
</div>

<style is:global>
  .theme-toggle {
    display: flex;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1;
  }
  .theme-toggle button {
    appearance: none;
    background: none;
    border: none;
    border-bottom: 1px solid transparent;
    padding: 0 0 2px;
    cursor: pointer;
    font: inherit;
    color: var(--toggle-off);
  }
  .theme-toggle button:hover {
    color: var(--ink);
  }
  .theme-toggle button[aria-pressed="true"] {
    color: var(--ink);
    border-bottom-color: var(--ink);
    cursor: default;
  }
</style>

<script is:inline>
  (function () {
    var groups = document.querySelectorAll(".theme-toggle");
    var favicon = document.getElementById("favicon");

    function apply(theme) {
      document.documentElement.dataset.theme = theme;
      if (favicon) {
        favicon.href = theme === "dark" ? "/favicon-amber.svg" : "/favicon-rust.svg";
      }
      groups.forEach(function (group) {
        group.querySelectorAll("[data-set-theme]").forEach(function (btn) {
          btn.setAttribute("aria-pressed", String(btn.dataset.setTheme === theme));
        });
      });
    }

    apply(document.documentElement.dataset.theme || "light");

    groups.forEach(function (group) {
      group.addEventListener("click", function (e) {
        var btn = e.target.closest("[data-set-theme]");
        if (!btn) return;
        var theme = btn.dataset.setTheme;
        try {
          localStorage.setItem("theme", theme);
        } catch (_) {}
        apply(theme);
      });
    });
  })();
</script>
