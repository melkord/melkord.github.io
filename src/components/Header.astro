---
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	variant?: 'home' | 'inner';
	width?: 'default' | 'post' | 'narrow';
	back?: boolean;
	/** Right side of the inner header: the theme toggle, a page label, or nothing. */
	label?: string;
	toggle?: boolean;
}

const { variant = 'inner', width = 'default', back = true, label, toggle = true } = Astro.props;

const GITHUB = 'https://github.com/melkord';
const LINKEDIN = 'https://www.linkedin.com/in/andreaterruggia';

const widthClass =
	width === 'post' ? 'page page--post' : width === 'narrow' ? 'page page--narrow' : 'page';
---

{
	variant === 'home' ? (
		<header class="site-header">
			<div class={widthClass}>
				<a href="/" class="eyebrow eyebrow-link">Andrea Terruggia</a>
				<p class="tagline">{SITE_DESCRIPTION}</p>
				<div class="home-bar">
					<nav class="home-nav">
						<a href="/about">about</a>
						<a href={GITHUB} target="_blank" rel="noopener noreferrer">github</a>
						<a href={LINKEDIN} target="_blank" rel="noopener noreferrer" class="desktop-only">linkedin</a>
					</nav>
					<ThemeToggle />
				</div>
			</div>
		</header>
	) : (
		<header class="inner-header">
			<div class={`${widthClass} inner-header-row`}>
				<a href="/" class="home-link">{back ? '← ' : ''}{SITE_TITLE}</a>
				{label ? <span class="inner-label">{label}</span> : toggle && <ThemeToggle />}
			</div>
		</header>
	)
}

<style>
	/* -------------------------------------------------- home (stacked) */
	.site-header {
		padding: 44px 0 20px;
	}
	.eyebrow-link {
		width: fit-content;
	}
	.eyebrow-link:hover {
		color: var(--ink);
	}
	.tagline {
		margin: 14px 0 0;
		max-width: 44ch;
		font-family: var(--font-sans);
		font-size: 21px;
		line-height: 1.36;
		font-weight: 500;
		letter-spacing: -0.018em;
		color: var(--ink);
	}
	.home-bar {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 24px;
		margin-top: 22px;
	}
	.home-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 18px;
		font-family: var(--font-mono);
		font-size: 12px;
		line-height: 1;
	}
	.home-nav a {
		color: var(--accent);
		border-bottom: 1px solid var(--accent-rule);
		padding-bottom: 2px;
	}
	.home-nav a:hover {
		color: var(--ink);
		border-bottom-color: var(--rule);
	}

	/* -------------------------------------------------- inner (row) */
	.inner-header {
		border-bottom: 1px solid var(--rule);
	}
	.inner-header-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 24px;
		padding: 30px 0;
	}
	.home-link {
		font-family: var(--font-mono);
		font-size: 14px;
		line-height: 1;
		font-weight: 500;
		color: var(--ink);
	}
	.home-link:hover {
		color: var(--accent);
	}
	.inner-label {
		font-family: var(--font-sans);
		font-size: 13px;
		line-height: 1;
		color: var(--toggle-off);
	}

	/* Mobile: linkedin moves to About, links get a ≥44px tap area. */
	@media (max-width: 720px) {
		.site-header {
			padding: 28px 0 16px;
		}
		.tagline {
			margin-top: 12px;
			font-size: 18px;
			line-height: 1.38;
			letter-spacing: -0.015em;
		}
		.home-bar {
			align-items: center;
			gap: 12px;
			margin-top: 18px;
		}
		.home-nav {
			gap: 14px;
		}
		.home-nav a,
		.home-bar :global(.theme-toggle button) {
			padding: 14px 0;
		}
		.home-bar :global(.theme-toggle) {
			gap: 8px;
		}
		.desktop-only {
			display: none;
		}
		.home-link,
		.inner-header-row :global(.theme-toggle button) {
			padding: 14px 0;
		}
	}
</style>
