---
interface Props {
  tag: string;
}
const { tag } = Astro.props;
---
<span class="tag-chip">{tag}</span>

<style>
  .tag-chip {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    color: var(--chip-ink);
    border: 1px solid var(--chip-border);
    border-radius: 3px;
    padding: 5px 8px;
  }
</style>
