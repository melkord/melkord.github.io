---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TagBadge from '../components/TagBadge.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	prevPost?: { id: string; title: string } | null;
	readingTime?: number;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	tags = [],
	prevPost = null,
	readingTime,
} = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header variant="inner" width="post" back />
		<main class="page page--post">
			<article class="post">
				<div class="post-meta">
					<FormattedDate date={pubDate} />
					{readingTime && (
						<>
							<span aria-hidden="true">·</span>
							<span>{readingTime} min read</span>
						</>
					)}
					{updatedDate && (
						<>
							<span aria-hidden="true">·</span>
							<span class="updated">updated <FormattedDate date={updatedDate} /></span>
						</>
					)}
				</div>
				<h1 class="post-title">{title}</h1>
				<p class="post-summary">{description}</p>
				{tags.length > 0 && (
					<div class="post-chips">
						{tags.map((tag: string) => (
							<TagBadge tag={tag} />
						))}
					</div>
				)}
				<hr class="post-rule" />
				<div class="prose">
					<slot />
				</div>
				<nav class="post-nav">
					{prevPost ? (
						<a href={`/${prevPost.id}/`} class="post-nav-prev">← {prevPost.title}</a>
					) : (
						<span />
					)}
					<a href="/" class="post-nav-all">All posts</a>
				</nav>
			</article>
		</main>
	</body>
</html>

<style>
	main {
		padding-bottom: 64px;
	}
	.post {
		max-width: 660px;
		margin: 0 auto;
	}
	.post-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		align-items: baseline;
		margin-top: 52px;
		font-family: var(--font-mono);
		font-size: 11.5px;
		line-height: 1;
		color: var(--muted);
	}
	.updated {
		font-style: italic;
	}
	.post-title {
		margin-top: 16px;
		font-family: var(--font-serif);
		font-size: 40px;
		line-height: 1.14;
		font-weight: 300;
		letter-spacing: -0.018em;
	}
	.post-summary {
		margin-top: 18px;
		font-family: var(--font-serif);
		font-size: 17px;
		line-height: 1.6;
		color: var(--quote-ink);
	}
	.post-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 22px;
	}
	.post-rule {
		margin: 38px 0 34px;
	}

	.post-nav {
		display: flex;
		justify-content: space-between;
		gap: 24px;
		margin-top: 44px;
		padding-top: 22px;
		border-top: 1px solid var(--rule);
		font-family: var(--font-sans);
		font-size: 13px;
		line-height: 1.5;
	}
	.post-nav-prev {
		max-width: 26ch;
		color: var(--accent);
	}
	.post-nav-prev:hover {
		color: var(--ink);
	}
	.post-nav-all {
		white-space: nowrap;
		color: var(--toggle-off);
	}
	.post-nav-all:hover {
		color: var(--ink);
	}

	@media (max-width: 720px) {
		.post-meta {
			margin-top: 36px;
		}
		.post-title {
			font-size: 30px;
		}
	}

	/* --------------------------------------------------------- prose */
	.prose {
		color: var(--prose);
		font-family: var(--font-sans);
		font-size: 16.5px;
		line-height: 1.72;
	}
	.prose :global(p) {
		margin: 0 0 20px;
	}
	.prose :global(h2) {
		margin: 38px 0 12px;
		font-family: var(--font-serif);
		font-size: 25px;
		line-height: 1.3;
		font-weight: 400;
		letter-spacing: -0.01em;
		color: var(--ink);
	}
	.prose :global(h3) {
		margin: 30px 0 10px;
		font-family: var(--font-serif);
		font-size: 20px;
		line-height: 1.35;
		font-weight: 400;
		color: var(--ink);
	}
	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 20px;
		padding-left: 1.3em;
	}
	.prose :global(li) {
		margin-bottom: 8px;
	}
	.prose :global(li::marker) {
		color: var(--muted);
	}
	.prose :global(a) {
		color: var(--accent);
		border-bottom: 1px solid var(--accent-rule);
	}
	.prose :global(a:hover) {
		border-bottom-color: var(--accent);
	}
	.prose :global(strong) {
		font-weight: 600;
		color: var(--ink);
	}
	.prose :global(hr) {
		margin: 38px 0;
	}

	.prose :global(:not(pre) > code) {
		font-family: var(--font-mono);
		font-size: 14.5px;
		background: var(--code-inline-bg);
		padding: 2px 5px;
		border-radius: 3px;
	}

	/* Shiki output — always dark, gets chrome wrapped by the script below */
	.prose :global(pre.astro-code) {
		margin: 0;
		padding: 18px;
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: 13px;
		line-height: 1.75;
		background-color: var(--code-bg) !important;
	}
	.prose :global(.code-block) {
		margin: 0 0 24px;
		border: 1px solid var(--rule);
		border-radius: 5px;
		overflow: hidden;
		background: var(--code-bg);
	}
	.prose :global(.code-bar) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 9px 14px;
		background: var(--code-bar-bg);
		font-family: var(--font-mono);
		font-size: 11px;
		line-height: 1;
		color: var(--code-bar-ink);
	}
	.prose :global(.code-copy) {
		appearance: none;
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		font: inherit;
		color: var(--code-bar-ink);
	}
	.prose :global(.code-copy:hover) {
		color: var(--code-ink);
	}

	.prose :global(blockquote) {
		margin: 0 0 24px;
		padding-left: 20px;
		border-left: 1px solid var(--quote-rule);
	}
	.prose :global(blockquote p) {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 18px;
		line-height: 1.6;
		font-style: italic;
		color: var(--quote-ink);
	}

	.prose :global(.callout) {
		margin: 0 0 24px;
		padding: 16px 18px;
		border-left: 2px solid var(--accent);
		background: var(--callout-bg);
	}
	.prose :global(.callout p) {
		margin: 0;
		font-size: 14.5px;
		line-height: 1.65;
		color: var(--prose);
	}

	.prose :global(figure) {
		margin: 0 0 24px;
	}
	.prose :global(figure img) {
		border-radius: 3px;
	}
	.prose :global(figcaption) {
		margin-top: 8px;
		font-family: var(--font-mono);
		font-size: 11.5px;
		line-height: 1.5;
		text-align: center;
		color: var(--faint);
	}
</style>

<script is:inline>
	(function () {
		var blocks = document.querySelectorAll(".prose pre.astro-code");
		blocks.forEach(function (pre) {
			var wrapper = document.createElement("figure");
			wrapper.className = "code-block";

			var bar = document.createElement("div");
			bar.className = "code-bar";

			var lang = document.createElement("span");
			var langName = pre.getAttribute("data-language") || "";
			lang.textContent = !langName || langName === "plaintext" ? "text" : langName;

			var btn = document.createElement("button");
			btn.type = "button";
			btn.className = "code-copy";
			btn.textContent = "copy";
			btn.addEventListener("click", function () {
				navigator.clipboard.writeText(pre.innerText).then(function () {
					btn.textContent = "copied";
					setTimeout(function () {
						btn.textContent = "copy";
					}, 1500);
				});
			});

			bar.appendChild(lang);
			bar.appendChild(btn);

			pre.parentNode.insertBefore(wrapper, pre);
			wrapper.appendChild(bar);
			wrapper.appendChild(pre);
		});
	})();
</script>
